{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itsmeh1.github.io/Murmur/api/schemas/event.schema.json",
  "title": "Murmur event",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "message.created"
        },
        "message": {
          "$ref": "message.schema.json"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "message",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "widget.created"
        },
        "message": {
          "$ref": "message.schema.json"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "message",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "member.joined",
            "member.left"
          ]
        },
        "member": {
          "type": "object"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "member",
        "cursor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "members.updated",
            "presence.changed"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "members",
        "cursor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "widget.resolved"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "type": "object"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id",
        "result",
        "cursor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress.updated"
        },
        "id": {
          "type": "string"
        },
        "percent": {
          "type": "number"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id",
        "percent",
        "cursor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "error": {
          "type": "string"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "error",
        "cursor"
      ]
    }
  ]
}
