{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itsmeh1.github.io/Murmur/api/schemas/event.schema.json",
  "title": "Murmur persisted room event",
  "description": "Events returned by GET /v1/rooms/{roomId}/events. Every persisted event has a monotonically increasing cursor.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "message.created"
        },
        "message": {
          "$ref": "message.schema.json"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "message",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "widget.created"
        },
        "message": {
          "$ref": "message.schema.json"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "message",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "member.joined",
            "member.left"
          ]
        },
        "member": {
          "type": "object"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "member",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "widget.resolved"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "type": "object"
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id",
        "result",
        "cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress.updated"
        },
        "id": {
          "type": "string"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id",
        "percent",
        "cursor"
      ],
      "additionalProperties": false
    }
  ]
}
